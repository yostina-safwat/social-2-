PORT=3000
MONGODB_URL=mongodb://127.0.0.1:27017/social-app

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# smtp: send emails with Gmail (needs MAIL_USER and MAIL_PASSWORD)
# console: development only, prints the emails (and the OTP codes) in the terminal
MAIL_PROVIDER=smtp
MAIL_USER=
MAIL_PASSWORD=

GOOGLE_WEB_OAUTH_CLIENT_ID=

# redis: use a redis server (default)
# memory: development only, keeps the OTP codes in the server memory, no redis needed
CACHE_PROVIDER=redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# optional, only needed if you use the Mailjet provider
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=

# where profile pictures are stored: local (uploads/ folder) or s3
CLOUD_PROVIDER=local

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET_NAME=
