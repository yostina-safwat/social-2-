{
  "info": {
    "name": "Social-App API",
    "description": "Auth, user, post and comment modules of the Social-App backend. Tokens are sent as httpOnly cookies, so run Login first and Postman will reuse the cookies for the following requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    }
  ],
  "item": [
    {
      "name": "auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates a new user and emails a 6-digit verification code (valid for 3 minutes).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"john\",\n  \"email\": \"john@example.com\",\n  \"password\": \"1234567\",\n  \"phoneNumber\": \"01000000000\",\n  \"gender\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verify Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-account",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-account"
              ]
            },
            "description": "Activates the account using the code sent by email.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Sets the access_token and refresh_token cookies. After 5 wrong passwords the account is locked for 3 minutes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"1234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "send-otp"
              ]
            },
            "description": "Sends a new OTP (when the old one expired or for password reset).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "reset-password"
              ]
            },
            "description": "Sets a new password using the OTP sent by email.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"code\": \"123456\",\n  \"newPassword\": \"7654321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login With Google",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login-google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login-google"
              ]
            },
            "description": "Signs in (or registers) with a Google ID token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<google-id-token>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh-token"
              ]
            },
            "description": "Issues a new access/refresh token pair using the refresh_token cookie."
          }
        }
      ]
    },
    {
      "name": "user",
      "item": [
        {
          "name": "Upload Profile Picture",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/upload-profile-pic",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "upload-profile-pic"
              ]
            },
            "description": "Uploads the profile picture through the server (replaces the old one). Requires login. Form-data file field named `pp`.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "pp",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Get Presigned Url",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/get-presigned-url",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "get-presigned-url"
              ]
            },
            "description": "Returns a temporary url (5 minutes) to upload the picture straight to S3 with a PUT request. Needs CLOUD_PROVIDER=s3. Requires login.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"me.png\",\n  \"contentType\": \"image/png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete Profile Picture",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/delete-profile-pic",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "delete-profile-pic"
              ]
            },
            "description": "Deletes the profile picture of the logged in user. Requires login."
          }
        }
      ]
    },
    {
      "name": "post",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/post",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "post"
              ]
            },
            "description": "Creates a post for the logged in user.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"my first post\",\n  \"allowsComments\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/post?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "post"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Returns the posts of the logged in user, newest first."
          }
        },
        {
          "name": "Get Single Post",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/post/<post id>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "post",
                "<post id>"
              ]
            },
            "description": "Returns one post by its id (cached for 5 minutes)."
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/post/<post id>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "post",
                "<post id>"
              ]
            },
            "description": "Only the post owner can update the post.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"edited post\",\n  \"allowsComments\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/post/<post id>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "post",
                "<post id>"
              ]
            },
            "description": "Only the post owner can delete the post."
          }
        }
      ]
    },
    {
      "name": "comment",
      "item": [
        {
          "name": "Create Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/comment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "comment"
              ]
            },
            "description": "Adds a comment to a post. Send parentId to reply to a comment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"postId\": \"<post id>\",\n  \"content\": \"nice post\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get Post Comments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/comment/post/<post id>?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "comment",
                "post",
                "<post id>"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Returns the comments of a post, newest first."
          }
        },
        {
          "name": "Get Single Comment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/comment/<comment id>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "comment",
                "<comment id>"
              ]
            },
            "description": "Returns one comment by its id."
          }
        },
        {
          "name": "Update Comment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/comment/<comment id>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "comment",
                "<comment id>"
              ]
            },
            "description": "Only the comment owner can update the comment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"edited comment\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/comment/<comment id>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "comment",
                "<comment id>"
              ]
            },
            "description": "Only the comment owner or the post owner can delete the comment."
          }
        }
      ]
    }
  ]
}
